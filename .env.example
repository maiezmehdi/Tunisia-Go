# Affiliate ids for the "Trouver un logement" buttons
NEXT_PUBLIC_BOOKING_AID=
NEXT_PUBLIC_AIRBNB_AFFILIATE=

# WhatsApp numbers, digits only with country code (e.g. 21698123456)
NEXT_PUBLIC_GUIDE_WHATSAPP=
NEXT_PUBLIC_TRANSFER_WHATSAPP=

# CARTO Basemaps API key (removes the "API key required" watermark on the map)
NEXT_PUBLIC_CARTO_API_KEY=

# Where "Ajouter un spot secret" suggestions are sent (Slack, Discord, Make or Zapier webhook URL).
# Server-only. Without it, the form hands the suggestion over to WhatsApp instead.
SECRET_SPOT_WEBHOOK_URL=

# Supabase, for secret spot suggestions and their photos (server-only, never NEXT_PUBLIC_).
# Run db/spot-submissions.sql once in the Supabase SQL editor first.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Password for the moderation page /admin (8 characters minimum). Server only.
ADMIN_PASSWORD=

# PostHog (EU cloud) audience statistics, loaded only after the visitor accepts cookies.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Google Gemini API key for the "Améliorer mon texte" / "Reformuler" buttons. Server only; optional
# (without it the buttons answer that the feature is not active). GEMINI_MODEL overrides the default model.
GEMINI_API_KEY=
